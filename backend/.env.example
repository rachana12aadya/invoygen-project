# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/invoygen
MONGODB_URI=mongodb://127.0.0.1:27017/invoygen

# ── JWT (different secrets, each at least 64 chars) ─────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-access-secret-must-be-at-least-64-characters-long-xx
JWT_REFRESH_SECRET=replace-me-refresh-secret-must-be-at-least-64-characters-long-x
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Frontend / CORS (comma-separated for multiple origins) ──
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Email (Nodemailer / SMTP provider) ──────────────────
# Local: Mailhog (smtp://localhost:1025) or Ethereal
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=invoygen
SMTP_PASS=invoygen
EMAIL_FROM="invoygen <no-reply@example.com>"
CONTACT_INBOX=founder@example.com

# ── Monitoring ──────────────────────────────────────────
SENTRY_DSN=
